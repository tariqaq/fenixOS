# Bluedroid probe (P30): applied on top of sdkconfig.defaults in its own build folder, never in
# the release build. One image with Bluetooth Classic + BLE (Bluedroid) and Wi-Fi at full speed;
# boots alternate between them (radio.cpp). Build:
#   pwsh -NoProfile -File board/idf.ps1 -B build-bluedroid -D SDKCONFIG=build-bluedroid/sdkconfig
#     -D "SDKCONFIG_DEFAULTS=sdkconfig.defaults;sdkconfig.bluedroid" build
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_SPP_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
CONFIG_LWIP_IRAM_OPTIMIZATION=y
# The probe logs from SPP/GAP callbacks, which run on BTC_TASK: 3072 overflowed (P30).
CONFIG_BT_BTC_TASK_STACK_SIZE=4096
# Bluetooth sized for one PC (SPP) and one phone (BLE GATT server).
CONFIG_BTDM_CTRL_BLE_MAX_CONN=1
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=1
CONFIG_BT_ACL_CONNECTIONS=2
# CONFIG_BT_MULTI_CONNECTION_ENBALE is not set
CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=y
# CONFIG_BT_GATTC_ENABLE is not set
CONFIG_BT_SMP_MAX_BONDS=4
CONFIG_BT_STACK_NO_LOG=y
# CONFIG_BT_BLE_42_DTM_TEST_EN is not set
# CONFIG_BT_BLE_42_SCAN_EN is not set
# IRAM: Bluedroid with Wi-Fi's speed options overflows by 25 KB. Moving these to flash leaves
# 4 KB over; SRAM1 as IRAM takes the rest from the heap (only what is used).
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
# CONFIG_LOG_IN_IRAM is not set
CONFIG_ESP_SYSTEM_ESP32_SRAM1_REGION_AS_IRAM=y
# Size trims (P30 trial A, planned for the release build in P31): unused LVGL parts off, no log
# strings, no error names, newlib nano printf.
# CONFIG_LV_USE_ANIMIMG is not set
# CONFIG_LV_USE_ARCLABEL is not set
# CONFIG_LV_USE_BUTTONMATRIX is not set
# CONFIG_LV_USE_CALENDAR is not set
# CONFIG_LV_USE_CANVAS is not set
# CONFIG_LV_USE_CHART is not set
# CONFIG_LV_USE_CHECKBOX is not set
# CONFIG_LV_USE_DROPDOWN is not set
# CONFIG_LV_USE_IMAGEBUTTON is not set
# CONFIG_LV_USE_KEYBOARD is not set
# CONFIG_LV_USE_LED is not set
# CONFIG_LV_USE_LINE is not set
# CONFIG_LV_USE_LIST is not set
# CONFIG_LV_USE_MENU is not set
# CONFIG_LV_USE_MSGBOX is not set
# CONFIG_LV_USE_ROLLER is not set
# CONFIG_LV_USE_SCALE is not set
# CONFIG_LV_USE_SPAN is not set
# CONFIG_LV_USE_SPINBOX is not set
# CONFIG_LV_USE_TEXTAREA is not set
# CONFIG_LV_USE_TABLE is not set
# CONFIG_LV_USE_TABVIEW is not set
# CONFIG_LV_USE_TILEVIEW is not set
# CONFIG_LV_USE_WIN is not set
# CONFIG_LV_USE_THEME_SIMPLE is not set
# CONFIG_LV_USE_OBSERVER is not set
# CONFIG_LV_USE_BUTTON is not set
# LVGL's examples and demos call the widgets above; the build fails unless they are off too.
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
# CONFIG_ESP_ERR_TO_NAME_LOOKUP is not set
CONFIG_LIBC_NEWLIB_NANO_FORMAT=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
