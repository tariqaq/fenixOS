# SD spike: reports on the UART0 console at 115200 (the link is not used).
# partitions.csv is a copy of fenixOS's, so NVS and the apps partition are left alone.
CONFIG_ESP_CONSOLE_NONE=n
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
# Long file names (app ids name files), buffers on the heap.
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=255
# stdio buffer for files on FAT (default 0 = newlib's 128 B).
CONFIG_FATFS_VFS_FSTAT_BLKSIZE=4096
