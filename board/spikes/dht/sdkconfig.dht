# DHT spike (P59): reports on the UART0 console at 115200 (the link is not used).
# partitions.csv is a copy of fenixOS's, so NVS and the apps partition are left alone; the spike
# goes into ota_0 and `fenix flash board/build` puts fenixOS back.
CONFIG_ESP_CONSOLE_NONE=n
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
