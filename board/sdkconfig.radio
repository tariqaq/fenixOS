# Radio probe (P29): applied on top of sdkconfig.defaults in its own build folder, never in the
# release build. Wi-Fi station and BLE (NimBLE host, BLE-only controller) come up at boot so the
# Task manager shows what they cost. Build:
#   pwsh -NoProfile -File board/idf.ps1 -B build-radio -D SDKCONFIG=build-radio/sdkconfig
#     -D "SDKCONFIG_DEFAULTS=sdkconfig.defaults;sdkconfig.radio" build
CONFIG_BT_ENABLED=y
CONFIG_BT_NIMBLE_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BLE_ONLY=y
# IRAM: with these on, the image overflows IRAM by ~11 KB (P29). Off costs only peak Wi-Fi throughput.
# CONFIG_ESP_WIFI_IRAM_OPT is not set
# CONFIG_ESP_WIFI_RX_IRAM_OPT is not set
# Wi-Fi buffers for one network at modest speed (defaults are sized for throughput).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=4
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=16
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=16
# CONFIG_ESP_WIFI_AMPDU_TX_ENABLED is not set
# CONFIG_ESP_WIFI_AMPDU_RX_ENABLED is not set
CONFIG_ESP_WIFI_MGMT_SBUF_NUM=16
# BLE: one connection (a phone), smaller host buffer pools.
CONFIG_BT_NIMBLE_MAX_CONNECTIONS=1
CONFIG_BTDM_CTRL_BLE_MAX_CONN=1
CONFIG_BT_NIMBLE_MAX_BONDS=1
CONFIG_BT_NIMBLE_MSYS_1_BLOCK_COUNT=8
CONFIG_BT_NIMBLE_ACL_BUF_COUNT=12
CONFIG_BT_NIMBLE_MSYS_2_BLOCK_COUNT=8
