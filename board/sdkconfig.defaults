CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
# -Os: 33% smaller image at the same slide fps (P30/P31: the slide is SPI-bound).
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# The UI (main task) gets core 1 to itself; the link and the radios stay on core 0 (P29).
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y
# Task list and per-task run times (esp_timer µs) for the PC's Task manager (SYSINFO, P27).
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
# UART0 is the PC link: keep console and logs off it.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
# No log strings in the image: nothing reads ESP_LOG output (the PC log is link_log). P31.
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
# CONFIG_ESP_ERR_TO_NAME_LOOKUP is not set
CONFIG_LIBC_NEWLIB_NANO_FORMAT=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
# LVGL: system heap, 16-bit colour, 1 ms timer resolution (fps cap set per display).
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=16
# Widgets with style opacity draw through this layer in strips (P37): 24 KB by default was the
# peak that ran the heap out during a stream over Wi-Fi; 8 KB means more, shorter strips.
CONFIG_LV_DRAW_LAYER_SIMPLE_BUF_SIZE=8192
# Rendering speed (P4 profiling, docs/board-info.md): corner masks for many radii, style lookups.
CONFIG_LV_DRAW_SW_CIRCLE_CACHE_SIZE=16
CONFIG_LV_OBJ_STYLE_CACHE=y

# App installs write flash while the PC streams chunks: keep the UART ISR running then (P6).
CONFIG_UART_ISR_IN_IRAM=y

# Flash (P31): only the LVGL widgets fenixOS uses (obj, label, image, bar, slider, switch,
# spinner + arc; flex and grid). LVGL's examples and demos call the others, so they go too.
# Default font: fenixOS sets its own fonts everywhere; UNSCII 8 (1 bpp ASCII) replaces
# Montserrat 14 (13.6 KB) as the unused theme default.
CONFIG_LV_FONT_DEFAULT_UNSCII_8=y
# CONFIG_LV_FONT_MONTSERRAT_14 is not set
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set
# CONFIG_LV_USE_ANIMIMG is not set
# CONFIG_LV_USE_ARCLABEL is not set
# CONFIG_LV_USE_BUTTON is not set
# CONFIG_LV_USE_BUTTONMATRIX is not set
# CONFIG_LV_USE_CALENDAR is not set
# CONFIG_LV_USE_CANVAS is not set
# CONFIG_LV_USE_CHART is not set
# CONFIG_LV_USE_CHECKBOX is not set
# CONFIG_LV_USE_DROPDOWN is not set
# CONFIG_LV_USE_IMAGEBUTTON is not set
# CONFIG_LV_USE_KEYBOARD is not set
# CONFIG_LV_USE_LED is not set
# CONFIG_LV_USE_LINE is not set
# CONFIG_LV_USE_LIST is not set
# CONFIG_LV_USE_MENU is not set
# CONFIG_LV_USE_MSGBOX is not set
# CONFIG_LV_USE_ROLLER is not set
# CONFIG_LV_USE_SCALE is not set
# CONFIG_LV_USE_SPAN is not set
# CONFIG_LV_USE_SPINBOX is not set
# CONFIG_LV_USE_TABLE is not set
# CONFIG_LV_USE_TABVIEW is not set
# CONFIG_LV_USE_TEXTAREA is not set
# CONFIG_LV_USE_TILEVIEW is not set
# CONFIG_LV_USE_WIN is not set
# CONFIG_LV_USE_THEME_SIMPLE is not set
# CONFIG_LV_USE_OBSERVER is not set

# Radio (P32): Wi-Fi or off. Bluetooth (Bluedroid, SPP and BLE) was removed in P38: too little
# heap left, a slow Windows COM port, ~1 KB/s (docs/decisions.md).
# CONFIG_BT_ENABLED is not set
# Wi-Fi at full speed: IRAM speed options stay on; lwIP hot paths in IRAM.
# Dynamic Wi-Fi buffers capped at 16 each way (default 32, P37): a stream over Wi-Fi held
# ~26 KB in flight and ran the heap down to 2 KB.
CONFIG_ESP_WIFI_DYNAMIC_TX_BUFFER_NUM=10
CONFIG_ESP_WIFI_DYNAMIC_RX_BUFFER_NUM=10
# Static RX buffers stay allocated in Wi-Fi mode (1.6 KB each): 8, still above the 6-frame
# block-ack window (default 10, P37).
CONFIG_ESP_WIFI_STATIC_RX_BUFFER_NUM=8
# Stacks with KBs unused (P37 high-water marks): mDNS used ~1.5 KB.
CONFIG_ESP_TIMER_TASK_STACK_SIZE=2560
CONFIG_MDNS_TASK_STACK_SIZE=3072
# Each small send() got a whole-MSS (1.5 KB) pbuf, and 16 of them queue: a quarter MSS keeps
# a pbuf near the size of its data (P37; off is not allowed with single-pbuf Wi-Fi TX).
CONFIG_LWIP_TCP_OVERSIZE_QUARTER_MSS=y
# Wi-Fi events (scan results, state) are framed for the PC on the event task. Frames are built
# in a static buffer since P34, so the task peaks at ~1.1 KB: 3072 (was 5120, P32).
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=3072
CONFIG_LWIP_IRAM_OPTIMIZATION=y
# CONFIG_LOG_IN_IRAM is not set
# SNTP (P34): pool.ntp.org and time.cloudflare.com.
CONFIG_LWIP_SNTP_MAX_SERVERS=2
