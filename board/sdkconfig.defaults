CONFIG_IDF_TARGET="esp32"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_ESPTOOLPY_FLASHMODE_QIO=y
CONFIG_ESPTOOLPY_FLASHFREQ_80M=y
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_ESP_DEFAULT_CPU_FREQ_MHZ_240=y
CONFIG_FREERTOS_HZ=1000
# -Os: 33% smaller image at the same slide fps (P30/P31: the slide is SPI-bound).
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_COMPILER_OPTIMIZATION_ASSERTIONS_SILENT=y
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
# The UI (main task) gets core 1 to itself; the link and the radios stay on core 0 (P29).
CONFIG_ESP_MAIN_TASK_AFFINITY_CPU1=y
# Task list and per-task run times (esp_timer µs) for the PC's Task manager (SYSINFO, P27).
CONFIG_FREERTOS_USE_TRACE_FACILITY=y
CONFIG_FREERTOS_GENERATE_RUN_TIME_STATS=y
# UART0 is the PC link: keep console and logs off it.
CONFIG_ESP_CONSOLE_NONE=y
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y
# No log strings in the image: nothing reads ESP_LOG output (the PC log is link_log). P31.
CONFIG_LOG_DEFAULT_LEVEL_NONE=y
# CONFIG_ESP_ERR_TO_NAME_LOOKUP is not set
CONFIG_LIBC_NEWLIB_NANO_FORMAT=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_REBOOT=y
# LVGL: system heap, 16-bit colour, 1 ms timer resolution (fps cap set per display).
CONFIG_LV_COLOR_DEPTH_16=y
CONFIG_LV_USE_CLIB_MALLOC=y
CONFIG_LV_USE_CLIB_STRING=y
CONFIG_LV_USE_CLIB_SPRINTF=y
CONFIG_LV_DEF_REFR_PERIOD=16
# Rendering speed (P4 profiling, docs/board-info.md): corner masks for many radii, style lookups.
CONFIG_LV_DRAW_SW_CIRCLE_CACHE_SIZE=16
CONFIG_LV_OBJ_STYLE_CACHE=y

# App installs write flash while the PC streams chunks: keep the UART ISR running then (P6).
CONFIG_UART_ISR_IN_IRAM=y

# Flash (P31): only the LVGL widgets fenixOS uses (obj, label, image, bar, slider, switch,
# spinner + arc; flex and grid). LVGL's examples and demos call the others, so they go too.
# Default font: fenixOS sets its own fonts everywhere; UNSCII 8 (1 bpp ASCII) replaces
# Montserrat 14 (13.6 KB) as the unused theme default.
CONFIG_LV_FONT_DEFAULT_UNSCII_8=y
# CONFIG_LV_FONT_MONTSERRAT_14 is not set
# CONFIG_LV_BUILD_EXAMPLES is not set
# CONFIG_LV_BUILD_DEMOS is not set
# CONFIG_LV_USE_ANIMIMG is not set
# CONFIG_LV_USE_ARCLABEL is not set
# CONFIG_LV_USE_BUTTON is not set
# CONFIG_LV_USE_BUTTONMATRIX is not set
# CONFIG_LV_USE_CALENDAR is not set
# CONFIG_LV_USE_CANVAS is not set
# CONFIG_LV_USE_CHART is not set
# CONFIG_LV_USE_CHECKBOX is not set
# CONFIG_LV_USE_DROPDOWN is not set
# CONFIG_LV_USE_IMAGEBUTTON is not set
# CONFIG_LV_USE_KEYBOARD is not set
# CONFIG_LV_USE_LED is not set
# CONFIG_LV_USE_LINE is not set
# CONFIG_LV_USE_LIST is not set
# CONFIG_LV_USE_MENU is not set
# CONFIG_LV_USE_MSGBOX is not set
# CONFIG_LV_USE_ROLLER is not set
# CONFIG_LV_USE_SCALE is not set
# CONFIG_LV_USE_SPAN is not set
# CONFIG_LV_USE_SPINBOX is not set
# CONFIG_LV_USE_TABLE is not set
# CONFIG_LV_USE_TABVIEW is not set
# CONFIG_LV_USE_TEXTAREA is not set
# CONFIG_LV_USE_TILEVIEW is not set
# CONFIG_LV_USE_WIN is not set
# CONFIG_LV_USE_THEME_SIMPLE is not set
# CONFIG_LV_USE_OBSERVER is not set

# Radios (P32): Bluetooth Classic + BLE (Bluedroid) or Wi-Fi, one at a time (radio.cpp).
# Sizing and IRAM placement measured in P30 (docs/board-info.md "Radios one at a time").
CONFIG_BT_ENABLED=y
CONFIG_BT_BLUEDROID_ENABLED=y
CONFIG_BTDM_CTRL_MODE_BTDM=y
CONFIG_BT_CLASSIC_ENABLED=y
CONFIG_BT_SPP_ENABLED=y
CONFIG_BT_BLE_ENABLED=y
# SPP and GAP callbacks run on BTC_TASK: 3072 overflowed in P30.
CONFIG_BT_BTC_TASK_STACK_SIZE=4096
# One PC (SPP) and one phone (BLE GATT server).
CONFIG_BTDM_CTRL_BLE_MAX_CONN=1
CONFIG_BTDM_CTRL_BR_EDR_MAX_ACL_CONN=1
CONFIG_BT_ACL_CONNECTIONS=2
# CONFIG_BT_MULTI_CONNECTION_ENBALE is not set
CONFIG_BT_BLE_DYNAMIC_ENV_MEMORY=y
# CONFIG_BT_GATTC_ENABLE is not set
CONFIG_BT_SMP_MAX_BONDS=4
CONFIG_BT_STACK_NO_LOG=y
# CONFIG_BT_BLE_42_DTM_TEST_EN is not set
# CONFIG_BT_BLE_42_SCAN_EN is not set
# Wi-Fi at full speed: IRAM speed options and default buffers stay on; lwIP hot paths in IRAM.
# Wi-Fi events (scan results, state) are framed for the PC on the event task: 1.2 KB frame
# buffer on its stack. 2304 overflowed after a scan; 4096 left 744 B (P32).
CONFIG_ESP_SYSTEM_EVENT_TASK_STACK_SIZE=5120
CONFIG_LWIP_IRAM_OPTIMIZATION=y
# IRAM: Bluedroid with Wi-Fi's speed options overflows by 25 KB. These go to flash, and SRAM1
# as IRAM covers the rest from the heap (only what is used, ~4 KB; needs an IDF 5.x bootloader).
CONFIG_FREERTOS_PLACE_FUNCTIONS_INTO_FLASH=y
CONFIG_HEAP_PLACE_FUNCTION_INTO_FLASH=y
CONFIG_RINGBUF_PLACE_FUNCTIONS_INTO_FLASH=y
# CONFIG_LOG_IN_IRAM is not set
CONFIG_ESP_SYSTEM_ESP32_SRAM1_REGION_AS_IRAM=y
